{
    "compilerOptions": {
        "composite": false,
        "declarationMap": false,
        "emitDeclarationOnly": false,
        "importHelpers": true,
        "isolatedModules": true,
        "lib": ["es2022"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "noEmitOnError": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "es2022",
        "customConditions": ["@org/source"],
        "noUncheckedSideEffectImports": false,
        "types": ["*"],
        "paths": {
            "@org/form-engine": ["./libs/form-engine/src/index.ts"],
            "@org/table-builder": ["./libs/table-builder/src/index.ts"],
            "@org/test-lib": ["./libs/test-lib/src/index.ts"]
        }
    }
}
